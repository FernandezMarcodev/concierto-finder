# Imagen para correr los tests (ver docker-compose.test.yml). Mismo Python que producción.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# El código se monta como volumen al correr; -p no:cacheprovider evita dejar .pytest_cache en el repo.
CMD ["pytest", "-p", "no:cacheprovider"]
