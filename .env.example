# ====== Configuración local ======
# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore: nunca se versiona.

# --- PostgreSQL (usado por el servicio `db` de docker compose) ---
POSTGRES_USER=cambiame
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=cambiame

# --- Backend ---
# Dentro de docker compose la app recibe esta variable automáticamente
# apuntando al host `db`. Si corrés el backend fuera de Docker, usá `localhost`
# y el puerto publicado de la DB en docker-compose.yml (55432).
DATABASE_URL=postgresql://cambiame:cambiame@localhost:55432/cambiame
# Keep alive (solo en Render): la API se pingea cada 12 min para que no la duerman.
# Sin definir usa RENDER_EXTERNAL_URL (Render la define solo); vacía desactiva el ping.
# Solo pingea dentro de la franja KEEP_ALIVE_DESDE..KEEP_ALIVE_HASTA (hora argentina, 0-23).
# KEEP_ALIVE_URL=https://concierto-finder.onrender.com/
# KEEP_ALIVE_DESDE=9
# KEEP_ALIVE_HASTA=2
# Token que exige /ingestar_agendade (header "Authorization: Bearer <token>"
# o ?token=<token>). Sin valor, el endpoint responde 503. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_TOKEN=
# Nivel de logs del backend (DEBUG, INFO, WARNING...).
# LOG_LEVEL=INFO

# --- Frontend ---
# URL pública de la API que consume el frontend (se inyecta en el build de Docker).
# Local con Docker: http://localhost:8000
WEB_API_URL=http://localhost:8000